# 2CAM Property Hub 0.13.3
# Un solo paquete: central_repository | building_node | edge_agent
APP_NAME="2CAM Property Hub"
APP_ENV=production
APP_DEBUG=false
APP_DIAGNOSTICS=true
APP_LOG_LEVEL=debug
APP_LOG_REQUESTS=true
DIAGNOSTIC_TOKEN="GENERADO-POR-EL-INSTALADOR"
APP_URL="http://localhost/property-hub/public"
APP_TIMEZONE="America/Caracas"
APP_DEMO_MODE=false
APP_SESSION_NAME=property_hub_session
APP_KEY="GENERADA-POR-EL-INSTALADOR"

INSTANCE_ROLE=building_node
INSTANCE_UUID="GENERADO-POR-EL-INSTALADOR"
INSTANCE_CODE=PROP-001
INSTANCE_NAME="Propiedad"
INSTANCE_TYPE=urbanization
INSTALLATION_API_KEY="SECRETO-INDEPENDIENTE-POR-INSTALACION"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=property_hub_node
DB_USERNAME=property_hub_app
DB_PASSWORD=""

UPDATE_CHANNEL=stable
ALLOW_OFFLINE=true

# Bootstrap/compatibilidad para Property Node. Desde 0.13.0 la conexión operativa
# a Central se mantiene en bh_remote_connections. En Edge estos valores quedan vacíos.
CENTRAL_REPOSITORY_URL="https://central.example.com/property-hub/public"
CENTRAL_REGISTRATION_TOKEN=""

# Compatibilidad histórica Edge. No se configuran manualmente en operación normal:
# URL Node + PHEDGE se guardan en BD al emparejar y el Node aprovisiona Central.
PARENT_PROPERTY_CODE=""
PROPERTY_NODE_URL=""
PROPERTY_NODE_AGENT_KEY=""

# Solo Property Hub Central
REPOSITORY_ENABLED=false
REPOSITORY_PUBLIC_URL=""
REPOSITORY_PRIVATE_KEY_PATH="storage/keys/repository-private.pem"
REPOSITORY_PUBLIC_KEY_PATH="storage/keys/repository-public.pem"

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost/property-hub/public/oauth/google/callback.php"
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY_PATH="storage/keys/AuthKey_XXXXXXXXXX.p8"
APPLE_REDIRECT_URI="http://localhost/property-hub/public/oauth/apple/callback.php"
NOTIFY_EMAIL_ENABLED=false
NOTIFY_PUSH_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_SMS_ENABLED=false
BACKUP_RECOVERY_KEY=
