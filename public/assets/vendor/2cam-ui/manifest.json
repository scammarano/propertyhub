{
  "package": "2CAM UI Standard",
  "version": "1.2.0",
  "released_at": "2026-07-24",
  "built_from": [
    "2CAM UI Standard 1.1.6",
    "NP Visual Common 1.1.0"
  ],
  "requires": {
    "AdminLTE": ">=4.0",
    "PHP": ">=8.1"
  },
  "modules": [
    "adminlte-shell",
    "self-contained-appearance",
    "legacy-grid-compatibility",
    "persistent-sidebar",
    "explicit-closable-active-groups",
    "three-level-navigation",
    "long-sidebar-scroll-fix",
    "dashboard-layout",
    "responsive-dashboard-widgets",
    "tables-forms-modals",
    "superadmin-builders",
    "newprofit-widget-adapter"
  ],
  "compatibility": [
    "cam-* canonical classes",
    "np-* temporary aliases",
    "GROUP/SECTION/ITEM menus",
    "legacy 2cam sidebar storage migration",
    "explicit true/false group state migration"
  ]
}
